# Copy this file to private storage outside the Git checkout.  Do not commit the
# populated copy or the repository-scoped deploy key.

S2S_PUBLISH_CLONE=/srv/s2s/publisher/s2s-analysis
S2S_REPOSITORY_URL=git@github.com:Artamta/s2s-analysis.git
S2S_PUBLISH_BRANCH=main
S2S_DASHBOARD_SUBDIR=clean/fuxi-dashboard

# Public Git metadata for automation. Replace both placeholders with an
# institution-owned identity; the publisher refuses personal/placeholder fallbacks.
S2S_GIT_AUTHOR_NAME='S2S Forecast Automation'
S2S_GIT_AUTHOR_EMAIL=forecast-ops@institution.example

# Use a repository-scoped, write-enabled GitHub deploy key.  The public half is
# registered on this repository only; the private half remains chmod 0600.
GIT_SSH_COMMAND='ssh -i /srv/s2s/secrets/s2s-analysis-deploy-key -o IdentitiesOnly=yes -o BatchMode=yes'

# Private delivery target used by the scheduler's alert adapter.  Replace this
# placeholder only in the untracked private copy.
S2S_ALERT_EMAIL=forecast-ops@institution.example

# Optional SMTP/sendmail adapter settings belong in the same private copy.
S2S_ALERT_COMMAND=/usr/local/sbin/s2s-send-alert
