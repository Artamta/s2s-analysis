# Copy to a private, mode-0600 file and fill locally. Never commit populated values.
S2S_ALERT_EMAIL=

# Dedicated repository-scoped publishing identity and clean clone.
S2S_PUBLISH_CLONE=/srv/s2s/publisher/s2s-analysis
S2S_REPOSITORY_URL=git@github.com:Artamta/s2s-analysis.git
S2S_PUBLISH_BRANCH=main
S2S_DASHBOARD_SUBDIR=clean/fuxi-dashboard
S2S_DRIVER_PYTHON=/home/raj.ayush/.conda/envs/s2s-hind/bin/python
GIT_SSH_COMMAND='ssh -i /srv/s2s/secrets/s2s-analysis-deploy-key -o IdentitiesOnly=yes -o BatchMode=yes'

# Use an institution-owned public commit identity, not a personal address.
S2S_GIT_AUTHOR_NAME=S2S Forecast Automation
S2S_GIT_AUTHOR_EMAIL=forecast-ops@institution.example

# If Node is not installed system-wide, point PATH at a stable installation.
# Do not use a temporary /tmp installation for unattended production.
# PATH=/opt/node-v22/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
