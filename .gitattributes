* text=auto eol=lf

# Binary scientific and publication artifacts.
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.nc binary
*.nc4 binary
*.grib binary
*.grib2 binary
*.zarr binary
*.h5 binary
*.hdf5 binary

# Generated paper artifacts are kept for review/arXiv convenience, but should
# not dominate GitHub language statistics or code review diffs.
paper_v2/cache/*.csv linguist-generated=true
paper_v2/figs/* linguist-generated=true
paper_v2/tables/*.csv linguist-generated=true
paper_v2/tables/*.tex linguist-generated=true
paper_v2/s2s_india_benchmark.pdf linguist-generated=true
